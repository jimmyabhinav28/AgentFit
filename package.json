{
  "name": "agentfit",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "AgentFit: AI-planned workouts and food charts, tracked day by day",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply agentfit --local",
    "db:migrate": "wrangler d1 migrations apply agentfit --remote",
    "test": "node --test --no-warnings test/*.test.js",
    "build:data": "python3 tools/build-library.py && python3 tools/build-foods.py"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
